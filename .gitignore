# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# Build artifacts generated by the Documenter package (package is nested, so match at any depth)
**/docs/build/
**/docs/site/
# docs/make.jl copies MIGRATION.md in from the repository root at build time
**/docs/src/migration.md

# Manifests: gitignored for packages (records a fixed state; committed only for applications)
**/Manifest*.toml

# Local preferences
**/LocalPreferences.toml
**/JuliaLocalPreferences.toml

# Images: ignored by default so stray plots and screenshots never land in the tree. The documentation
# assets are generated by docs/generate_assets and committed on purpose, so they are excluded again.
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf
!**/docs/src/assets/**

# Editor / OS cruft
.DS_Store
*.swp
